+// SailMC: GL4ES batches immediate mode drawing and flushes it when it sees a buffer swap.
+// Here GLFW swaps through EGL behind its back, so flush GL4ES (libGL.so.1) explicitly.
+static void flushGL4ES(void)
+{
+    static void (*flush)(void);
+    static int initialized;
+    if (!initialized)
+    {
+        const char* forceGles = getenv("GLFW_FORCE_GLES");
+        initialized = 1;
+        if (forceGles && forceGles[0] != '0')
+        {
+            void* gl = dlopen("libGL.so.1", RTLD_LAZY | RTLD_NOLOAD);
+            if (gl)
+                flush = (void (*)(void)) dlsym(gl, "glFlush");
+        }
+    }
+    if (flush)
+        flush();
+}
