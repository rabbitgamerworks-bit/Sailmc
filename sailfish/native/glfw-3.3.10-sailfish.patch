+// SailMC: GLFW has no touch API, so touches are turned into mouse input.
+// One finger is the left button (dragging moves the camera while the cursor is captured),
+// a second finger is the right button.
+static struct wl_touch* touchDevice;
+static _GLFWwindow* touchWindow;
+static int32_t touchPrimaryId = -1;
+static int32_t touchSecondaryId = -1;
+static double touchLastX, touchLastY;
+
+static void touchMoveTo(_GLFWwindow* window, double x, double y)
+{
+    if (window->cursorMode == GLFW_CURSOR_DISABLED)
+    {
+        _glfwInputCursorPos(window,
+                            window->virtualCursorPosX + (x - touchLastX),
+                            window->virtualCursorPosY + (y - touchLastY));
+    }
+    else
+    {
+        window->wl.cursorPosX = x;
+        window->wl.cursorPosY = y;
+        _glfwInputCursorPos(window, x, y);
+    }
+    touchLastX = x;
+    touchLastY = y;
+}
+
+static void touchHandleDown(void* userData, struct wl_touch* touch, uint32_t serial,
+                            uint32_t time, struct wl_surface* surface, int32_t id,
+                            wl_fixed_t sx, wl_fixed_t sy)
+{
+    _GLFWwindow* window = surface ? wl_surface_get_user_data(surface) : NULL;
+    if (!window)
+        return;
+    const double x = wl_fixed_to_double(sx);
+    const double y = wl_fixed_to_double(sy);
+
+    if (touchPrimaryId < 0)
+    {
+        touchWindow = window;
+        touchPrimaryId = id;
+        _glfw.wl.serial = serial;
+        if (window->cursorMode != GLFW_CURSOR_DISABLED)
+            touchMoveTo(window, x, y);
+        touchLastX = x;
+        touchLastY = y;
+        _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_PRESS, 0);
+    }
+    else if (touchSecondaryId < 0 && window == touchWindow)
+    {
+        touchSecondaryId = id;
+        _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_RIGHT, GLFW_PRESS, 0);
+    }
+}
+
+static void touchHandleUp(void* userData, struct wl_touch* touch, uint32_t serial,
+                          uint32_t time, int32_t id)
+{
+    if (!touchWindow)
+        return;
+    if (id == touchSecondaryId)
+    {
+        touchSecondaryId = -1;
+        _glfwInputMouseClick(touchWindow, GLFW_MOUSE_BUTTON_RIGHT, GLFW_RELEASE, 0);
+    }
+    else if (id == touchPrimaryId)
+    {
+        touchPrimaryId = -1;
+        _glfwInputMouseClick(touchWindow, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, 0);
+    }
+}
+
+static void touchHandleMotion(void* userData, struct wl_touch* touch, uint32_t time,
+                              int32_t id, wl_fixed_t sx, wl_fixed_t sy)
+{
+    if (touchWindow && id == touchPrimaryId)
+        touchMoveTo(touchWindow, wl_fixed_to_double(sx), wl_fixed_to_double(sy));
+}
+
+static void touchHandleFrame(void* userData, struct wl_touch* touch)
+{
+}
+
+static void touchHandleCancel(void* userData, struct wl_touch* touch)
+{
+    if (touchWindow && touchPrimaryId >= 0)
+        _glfwInputMouseClick(touchWindow, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, 0);
+    if (touchWindow && touchSecondaryId >= 0)
+        _glfwInputMouseClick(touchWindow, GLFW_MOUSE_BUTTON_RIGHT, GLFW_RELEASE, 0);
+    touchPrimaryId = touchSecondaryId = -1;
+}
+
+static void touchHandleShape(void* userData, struct wl_touch* touch, int32_t id,
+                             wl_fixed_t major, wl_fixed_t minor)
+{
+}
+
+static void touchHandleOrientation(void* userData, struct wl_touch* touch, int32_t id,
+                                   wl_fixed_t orientation)
+{
+}
+
+static const struct wl_touch_listener touchListener =
+{
+    touchHandleDown,
+    touchHandleUp,
+    touchHandleMotion,
+    touchHandleFrame,
+    touchHandleCancel,
+    touchHandleShape,
+    touchHandleOrientation,
+};
