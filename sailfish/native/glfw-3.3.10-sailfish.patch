     if (window != _glfwPlatformGetTls(&_glfw.contextSlot))
@@ -281,6 +303,7 @@ static void swapBuffersEGL(_GLFWwindow* window)
         return;
 #endif
 
+    flushGL4ES();
     eglSwapBuffers(_glfw.egl.display, window->context.egl.surface);
 }
 
